{
    "git": {
        "commitMessage": "chore(release): release v${version}",
        "tagName": "v${version}"
    },
    "npm": false,
    "github": {
        "release": false
    },
    "plugins": {
        "@release-it/conventional-changelog": {
            "preset": {
                "name": "angular"
            },
            "infile": "CHANGELOG.md",
            "ignoreRecommendedBump": true
        },

        "@release-it-plugins/workspaces": {
            "publish": true,
            "skipChecks": true,
            "workspaces": [
                "packages/*"
            ]
        }
    }
}
